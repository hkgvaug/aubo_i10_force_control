# Install as /etc/udev/rules.d/99-kwr75-force-sensor.rules
#
# 1. Find the serial number:
#      udevadm info --name=/dev/ttyUSB0 --attribute-walk | grep serial
#    The KWR75 converter serial looks like FT6S4DSP.
# 2. Replace <serial number here> below, then:
#      sudo udevadm control --reload && sudo udevadm trigger
#
# latency_timer=1 ms matters for a continuous 1 kHz stream.
SUBSYSTEM=="tty", ATTRS{serial}=="<serial number here>", ENV{ID_MM_DEVICE_IGNORE}="1", ATTR{device/latency_timer}="1", SYMLINK+="robot/kwr75_force_sensor"
