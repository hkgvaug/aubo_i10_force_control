<?xml version="1.0"?>
<!--
  Standalone Gazebo model for testing the KWR75 FT plugin and the safety
  monitor.  The sensor is mounted on the world link; a 1 kg test tool hangs
  from ft_sensor_link so that the plugin sees a real load.

  This is a simulation-only model.  It is not part of the AUBO description.
-->
<robot name="kwr75_gazebo_test" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find kwr75_ft_sensor)/urdf/kwr75_ft_sensor.urdf.xacro"/>
  <xacro:include filename="$(find kwr75_ft_sensor)/urdf/kwr75_ft_sensor.gazebo.xacro"/>

  <link name="world"/>

  <!-- Sensor: mounting side fixed to the world, tool side at +Z. -->
  <xacro:kwr75_ft_sensor parent="world" xyz="0 0 0.6" rpy="0 0 0"/>

  <!-- 1 kg test tool.  Box is 50 x 50 x 50 mm. -->
  <link name="test_tool">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0004167" iyy="0.0004167" izz="0.0004167"
               ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="test_tool_joint" type="fixed">
    <parent link="ft_sensor_link"/>
    <child link="test_tool"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <gazebo reference="test_tool">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- Measures the wrench across the sensor base/tool-side joint. -->
  <xacro:kwr75_ft_sensor_gazebo
      joint_name="ft_sensor_link_joint"
      topic="/ft_sensor/wrench_raw"
      update_rate="250.0"/>
</robot>
