<?xml version="1.0"?>
<launch>
  <!-- The planning and execution components of MoveIt! configured to run -->
  <!-- using the ROS-Industrial interface. -->
 
  <rosparam command="load" file="$(find aubo_i10_moveit_config)/config/joint_names.yaml"/>

  <!-- sim:=false (default) is the real-robot ROS-I chain.
       sim:=true uses MoveIt fake execution, does not start aubo_driver /
       aubo_robot_simulator / aubo_joint_trajectory_action, and starts a
       fake /ft_sensor/wrench_raw publisher so the safety interlock is not
       blocked by a missing sensor.  Never use sim:=true on hardware. -->
  <arg name="sim" default="false" />
  <arg name="robot_ip" default="127.0.0.1"/>
  <!-- Auxiliary FT safety supervision.  Default ON for the real-robot
       launch; set start_ft_safety:=false only for a deliberate bypass. -->
  <arg name="start_ft_safety" default="true"/>
  <!-- In sim mode the fake wrench is on by default; override to false if
       another simulated source publishes /ft_sensor/wrench_raw. -->
  <arg name="start_fake_ft" default="$(arg sim)"/>

  <!-- Interpolation rate of the ROS-I simulator (Hz).  Lower values produce
       fewer trajectory points, which matters because the AUBO SDK delivers
       roughly one point per 0.1-1.2 s on this setup: the number of points is
       what fixes the achievable motion time, not the requested duration.
       The joint step fuse in aubo_driver (~max_joint_step_rad, default 0.002 rad)
       also caps joint speed at max_joint_step_rad * motion_update_rate, so keep
       this >= 200 or normal trajectories get rejected. -->
  <arg name="motion_update_rate" default="200"/>
  <param name="motion_update_rate" value="$(arg motion_update_rate)"/>

  <!-- Enforce the execution window in the move_group namespace.  The value in
       trajectory_execution.launch.xml did not reach /move_group at runtime
       (it kept the old 10x/30 s), so set it explicitly here. -->
  <group ns="move_group">
    <param name="trajectory_execution/allowed_execution_duration_scaling" value="25"/>
    <param name="trajectory_execution/allowed_goal_duration_margin" value="150.0"/>
  </group>
 
  <!-- load the robot_description parameter before launching ROS-I nodes -->
  <include file="$(find aubo_i10_moveit_config)/launch/planning_context.launch" >
    <arg name="load_robot_description" value="true" />
  </include>

 <!-- industrial_robot_simulator: accepts robot commands and reports status.
      Not used in sim:=true, where MoveIt's fake controller manager executes. -->
  <node pkg="aubo_controller" type="aubo_robot_simulator"
        name="aubo_robot_simulator" unless="$(arg sim)">
    <!-- Points the simulator may leave queued in the driver.  Small keeps the
         simulator paced to the driver's real push rate instead of dumping the
         whole trajectory and letting the arm play it back in jerky steps. -->
    <param name="min_buffer_size" value="5"/>
  </node>
  
  <!-- joint_trajectory_action: provides actionlib interface for high-level robot control -->
  <node pkg="aubo_controller" type="aubo_joint_trajectory_action"
        name="aubo_joint_trajectory_action" unless="$(arg sim)"/>

  <!-- run the "real robot" interface nodes -->
  <!--   - this typically includes: robot_state, motion_interface, and joint_trajectory_action nodes -->
  <!--   - replace these calls with appropriate robot-specific calls or launch files -->
  <!--<group unless="$(arg sim)">
    <include file="$(find aubo_greyorange_moveit_config)/launch/robot_interface.launch" >
      <arg name="robot_ip" value="$(arg robot_ip)"/>
    </include>
  </group> -->

 <!-- real-robot driver; never started in sim mode -->
  <node name="aubo_driver" pkg="aubo_driver" type="aubo_driver"
        unless="$(arg sim)">
  <param name="/server_host" type="str" value="$(arg robot_ip)"/>
  <param name="/external_axis_number" value= "0.0"/>
  </node>

  <!-- In sim mode the fake controller provides joint states. -->
  <node if="$(arg sim)" name="joint_state_publisher"
        pkg="joint_state_publisher" type="joint_state_publisher">
    <rosparam param="source_list">[move_group/fake_controller_joint_states]</rosparam>
  </node>

  <!-- publish the robot state (tf transforms) -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

  <!-- Simulation-only raw wrench source for the interlock. -->
  <node if="$(arg start_fake_ft)" name="fake_wrench"
        pkg="ft_safety_monitor" type="publish_fake_wrench.py"
        output="screen">
    <param name="topic" value="/ft_sensor/wrench_raw"/>
    <param name="rate" value="100.0"/>
    <param name="mode" value="normal"/>
    <param name="duration" value="0.0"/>
  </node>

  <!-- Force/torque safety monitor.  It faults if the KWR75 driver is not
       publishing, which is the intended fail-safe behaviour. -->
  <include file="$(find ft_safety_monitor)/launch/ft_safety_monitor.launch"
           if="$(arg start_ft_safety)">
    <arg name="wrench_topic" value="/ft_sensor/wrench_raw"/>
  </include>

  <include file="$(find aubo_i10_moveit_config)/launch/move_group.launch">
    <arg name="publish_monitored_planning_scene" value="true" />
    <arg name="fake_execution" value="$(arg sim)" />
  </include>

  <include file="$(find aubo_i10_moveit_config)/launch/moveit_rviz.launch">
    <arg name="config" value="true"/>
  </include>
  
  <!--<include file="$(find aubo_greyorange_moveit_config)/launch/default_warehouse_db.launch" />-->

</launch>
